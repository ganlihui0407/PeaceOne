NODE_ENV=development
PORT=3001

POSTGRES_USER=peaceone
POSTGRES_PASSWORD=change_me
POSTGRES_DB=peaceone
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DATABASE_URL=postgresql://peaceone:change_me@127.0.0.1:5432/peaceone

# Dedicated automated-test database. Must use a different database name from DATABASE_URL.
# Backend `npm test` refuses to start if this is missing or points at the presentation database.
# Initialize once with: npm run test:db:init --prefix server
TEST_DATABASE_URL=postgresql://peaceone:change_me@127.0.0.1:5432/peaceone_test

# Generate a long random value in the real server/.env. Never commit the real secret.
SESSION_SECRET=change_me_session_secret

# Generate a different long random value in the real server/.env. Never commit the real secret.
CSRF_SECRET=change_me_csrf_secret

# false for local HTTP. Set true when the API is served over HTTPS so session and CSRF cookies use Secure.
SESSION_COOKIE_SECURE=false

# Private resume file root. Must not be a public web directory (public/, dist/, Vite assets).
# PostgreSQL backups do not include these files; back up this directory with the database.
# If unset, Windows uses %LOCALAPPDATA%\PeaceOne\resume-storage, macOS uses
# ~/Library/Application Support/PeaceOne/resume-storage, and Linux uses
# $XDG_DATA_HOME/peaceone/resume-storage (or ~/.local/share/peaceone/resume-storage).
# PEACEONE_RESUME_STORAGE=

# Private application snapshot root. Must not be a public web directory (public/, dist/, Vite assets).
# PostgreSQL backups do not include these files; back up this directory with the database.
# If unset, Windows uses %LOCALAPPDATA%\PeaceOne\application-storage, macOS uses
# ~/Library/Application Support/PeaceOne/application-storage, and Linux uses
# $XDG_DATA_HOME/peaceone/application-storage (or ~/.local/share/peaceone/application-storage).
# PEACEONE_APPLICATION_STORAGE=

# Demonstration seed password (bcrypt-hashed at seed time; never stored in plaintext).
# Used by `npm run db:seed:demo`. Local development defaults to PeaceOneDemo1 if unset.
# DEMO_SEED_PASSWORD=PeaceOneDemo1
