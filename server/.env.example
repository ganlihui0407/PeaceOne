NODE_ENV=development
PORT=3001

POSTGRES_USER=peaceone
POSTGRES_PASSWORD=change_me
POSTGRES_DB=peaceone
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DATABASE_URL=postgresql://peaceone:change_me@127.0.0.1:5432/peaceone

# Generate a long random value in the real server/.env. Never commit the real secret.
SESSION_SECRET=change_me_session_secret

# Generate a different long random value in the real server/.env. Never commit the real secret.
CSRF_SECRET=change_me_csrf_secret

# false for local HTTP. Set true when the API is served over HTTPS so session and CSRF cookies use Secure.
SESSION_COOKIE_SECURE=false
