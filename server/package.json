{
    "name": "peaceone-server",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "PeaceOne backend API (Stage 3 foundation)",
    "scripts": {
        "start": "node src/index.js",
        "dev": "node --watch src/index.js",
        "prisma:validate": "prisma validate",
        "prisma:migrate": "prisma migrate dev",
        "test": "node --import ./test/setup.js --test --test-concurrency=1 test/session-csrf.test.js test/auth.test.js test/authorization.test.js test/security.test.js test/rate-limit.test.js test/esco-csv.test.js test/esco-import.test.js test/esco-api.test.js test/user-skills-api.test.js test/skill-gap-api.test.js test/career-target-api.test.js test/masco-api.test.js test/masco-crosswalk-api.test.js test/me-profile-api.test.js test/position-change-request-api.test.js test/company-api.test.js test/resume-api.test.js test/resume-storage.test.js test/resume-file.test.js test/resume-file-validation.test.js test/resume-upload.test.js test/resume-download.test.js test/resume-text-extraction.test.js test/resume-skill-matcher.test.js test/resume-extraction-api.test.js test/resume-templates.test.js test/resume-pdf-api.test.js test/job-api.test.js test/application-api.test.js test/employer-applicant-management.test.js test/interview-api.test.js test/notification-api.test.js",
        "test:notifications": "node --import ./test/setup.js --test --test-concurrency=1 test/notification-api.test.js",
        "test:interviews": "node --import ./test/setup.js --test --test-concurrency=1 test/interview-api.test.js",
        "test:jobs": "node --import ./test/setup.js --test --test-concurrency=1 test/job-api.test.js",
        "test:applications": "node --import ./test/setup.js --test --test-concurrency=1 test/application-api.test.js test/employer-applicant-management.test.js",
        "test:resumes": "node --import ./test/setup.js --test --test-concurrency=1 test/resume-api.test.js",
        "test:resume-files": "node --import ./test/setup.js --test --test-concurrency=1 test/resume-storage.test.js test/resume-file.test.js",
        "test:resume-upload": "node --import ./test/setup.js --test --test-concurrency=1 test/resume-file-validation.test.js test/resume-upload.test.js",
        "test:resume-download": "node --import ./test/setup.js --test --test-concurrency=1 test/resume-download.test.js",
        "test:resume-extract": "node --import ./test/setup.js --test --test-concurrency=1 test/resume-text-extraction.test.js",
        "test:resume-skills": "node --import ./test/setup.js --test --test-concurrency=1 test/resume-skill-matcher.test.js test/resume-extraction-api.test.js",
        "test:resume-pdf": "node --import ./test/setup.js --test --test-concurrency=1 test/resume-templates.test.js test/resume-pdf-api.test.js",
        "test:company": "node --import ./test/setup.js --test --test-concurrency=1 test/company-api.test.js",
        "test:me": "node --import ./test/setup.js --test --test-concurrency=1 test/me-profile-api.test.js",
        "test:position-change": "node --import ./test/setup.js --test --test-concurrency=1 test/position-change-request-api.test.js",
        "test:esco": "node --import ./test/setup.js --test test/esco-csv.test.js test/esco-import.test.js",
        "esco:import": "node scripts/import-esco.js",
        "esco:benchmark": "node scripts/benchmark-esco-import.js",
        "prisma:generate": "prisma generate",
        "db:up": "docker compose -f ../docker-compose.yml --env-file .env up -d",
        "db:stop": "docker compose -f ../docker-compose.yml --env-file .env stop"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^6.19.3",
        "@prisma/client": "^6.19.3",
        "bcryptjs": "^3.0.3",
        "connect-pg-simple": "^10.0.0",
        "cookie-parser": "^1.4.7",
        "csrf-csrf": "^4.0.3",
        "csv-parse": "^5.6.0",
        "dotenv": "^16.6.1",
        "express": "^4.21.2",
        "express-rate-limit": "^8.7.1",
        "express-session": "^1.19.0",
        "mammoth": "^1.13.0",
        "pdfjs-dist": "^6.5.438",
        "pdfkit": "^0.17.2",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "prisma": "^6.19.3"
    }
}
